# /srv/kph/secrets/caddy.env  (chmod 600, owner root). Read only by the Caddy container.
#
# The public host name (a DNS A record, and AAAA if you use IPv6, must point at this server before the first start).
# Caddy then gets and renews a Let's Encrypt certificate by itself. It must match PUBLIC_URL in app.env.
KPH_DOMAIN=hub.example.com
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=ops@example.com
