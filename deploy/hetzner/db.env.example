# /srv/kph/secrets/db.env  (chmod 600, owner root). Read only by the PostgreSQL container.
#
# The database owner. It creates the tables and runs migrations. The application itself never uses this login: it uses the
# restricted role kph_app from app.env. The same password goes into owner.env (DATABASE_OWNER_URL).
#
# Generate the password with:  openssl rand -hex 24
# It cannot be changed here after the first start (the database keeps the first one). To change it later, run
#   docker compose exec db psql -U kph_owner -d kph -c "ALTER ROLE kph_owner PASSWORD '...'"
# and update owner.env and this file together.
POSTGRES_USER=kph_owner
POSTGRES_DB=kph
POSTGRES_PASSWORD=CHANGE_ME_OWNER_DB_PASSWORD
