# /srv/kph/secrets/app.env  (chmod 600, owner root). Copy this file, then replace every CHANGE_ME.
# Read by the app, the worker and the migrate (ops) container through docker compose "env_file".
#
# File format: one KEY=value per line, no spaces around "=". Values with special characters (MASTER_KEYS) are wrapped in single quotes,
# which docker compose removes. Never commit this file. Never paste it into a chat or a ticket.

# ---------------------------------------------------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------------------------------------------------
NODE_ENV=production

# The public address of the Hub, https only. Used in email links and for the Google sign in redirect.
# The application refuses to start when this is not https.
PUBLIC_URL=https://hub.example.com

# The address of Caddy on the internal "edge" network (fixed in docker-compose.prod.yml). Only this proxy may set the visitor's IP address.
TRUST_PROXY=172.29.10.2
# TRUST_PROXY also accepts true, false, a number of hops, or a comma separated list of addresses, CIDR ranges and the names loopback,
# linklocal and uniquelocal (for example "loopback, 172.29.10.2"). A value it does not understand stops the app from starting.

# ---------------------------------------------------------------------------------------------------------------------
# Database (role kph_app: no superuser, no rights on the audit tables, row level security applies)
# ---------------------------------------------------------------------------------------------------------------------
# Use the generated password from: openssl rand -hex 24   (hex only, so it never needs URL encoding). At least 16 characters.
# The password must be different from the owner password. The migrate command creates or updates the role kph_app with it.
DATABASE_URL=postgres://kph_app:CHANGE_ME_APP_DB_PASSWORD@db:5432/kph

# ---------------------------------------------------------------------------------------------------------------------
# Encryption keys. THE MOST IMPORTANT SETTINGS. Losing a master key means losing every file and name sealed with it, for good.
# ---------------------------------------------------------------------------------------------------------------------
# Generate a key:   docker compose -f deploy/docker-compose.prod.yml run --rm migrate node dist/cli.js gen-key --id k1
# (that command needs valid settings, so for the very first key run:  openssl rand -base64 32 )
# MASTER_KEYS is a JSON object: key id -> 32 random bytes in base64. Ids are letters, digits, "_" or "-", up to 32 characters.
# Keep an OFFLINE copy of every master key (password manager entry plus a printed sealed copy in a safe). Keys are never removed from
# here until a "rewrap" run has moved everything to a newer key AND a backup made after that run has been restore tested.
MASTER_KEYS='{"k1":"CHANGE_ME_BASE64_32_BYTES","b1":"CHANGE_ME_OTHER_BASE64_32_BYTES"}'

# The key that seals new files and fields. To rotate: add a new key to MASTER_KEYS, change this id, restart, run "rewrap".
ACTIVE_KEY_ID=k1

# The key for the search index of patient names (exact name search without storing names in plain text).
# Use a key that you never rotate. If you ever change it, run "rewrap" (it rebuilds the index) and keep HASH_KEY_ID as it was.
BLIND_INDEX_KEY_ID=b1

# The key for hashes that cannot be recomputed: API keys, recovery codes and CSRF tokens. Leave it out to use BLIND_INDEX_KEY_ID.
# Set it to the OLD blind index key id before you change BLIND_INDEX_KEY_ID, otherwise every API key and recovery code stops working.
# HASH_KEY_ID=b1

# ---------------------------------------------------------------------------------------------------------------------
# File storage. Files are always encrypted before they are stored, whatever the driver.
# ---------------------------------------------------------------------------------------------------------------------
# fs  = local disk (/srv/kph/data/storage on the encrypted volume, mounted as /data/files in the containers)
# s3  = Hetzner Object Storage (or any S3 compatible store). Turn on bucket versioning and keep the bucket private.
STORAGE_DRIVER=fs

# Only for STORAGE_DRIVER=s3:
#S3_ENDPOINT=https://fsn1.your-objectstorage.com
#S3_BUCKET=kph-files-CHANGE_ME
#S3_REGION=fsn1
#S3_ACCESS_KEY_ID=CHANGE_ME
#S3_SECRET_ACCESS_KEY=CHANGE_ME
#S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------------------------------------------------
# Malware scanning. The application refuses to start without a scanner in production.
# ---------------------------------------------------------------------------------------------------------------------
SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------------------------------------------------
# Email. Required in production (invitations, password resets, notices).
# ---------------------------------------------------------------------------------------------------------------------
# smtp://user:password@host:587  (STARTTLS)  or  smtps://user:password@host:465  (TLS). Encode special characters in the password.
SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@smtp.example.com:465
MAIL_FROM=Portal Hub <no-reply@hub.example.com>
SUPPORT_EMAIL=support@example.com
# Shown to partners as the data protection contact. Required when SIGNUP_ENABLED is on.
PRIVACY_EMAIL=privacy@example.com

# ---------------------------------------------------------------------------------------------------------------------
# Sign in and sessions
# ---------------------------------------------------------------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
STEP_UP_MINUTES=10
# Password hashing cost (2^N). 17 is the default. The application refuses anything below 15 in production.
SCRYPT_LOG_N=17

# Self registration of partner companies (they still wait for K Line review). Off until you want it.
SIGNUP_ENABLED=false
SIGNUP_DAILY_LIMIT=100

# ---------------------------------------------------------------------------------------------------------------------
# Google Workspace sign in for K Line staff (optional). Leave these out to keep staff on password plus authenticator only.
# Create an OAuth client (type "Web application") in the Google Cloud console with the redirect URI
#   https://hub.example.com/api/auth/oidc/google/callback
# and set the consent screen to "Internal" so that only your Workspace can use it.
# ---------------------------------------------------------------------------------------------------------------------
#OIDC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
#OIDC_GOOGLE_CLIENT_SECRET=CHANGE_ME
# Only accounts in this Workspace domain may sign in (the "hd" claim is checked as well as the address).
#OIDC_ALLOWED_DOMAIN=klineeurope.com
# Two factor sign in switch. It is OFF for now (decision of 8 Oct 2026): a password (or Google) alone gives a full session, nobody is
# asked to set up an authenticator, and sensitive actions no longer ask for a code. Authenticator secrets and recovery codes that already
# exist are kept untouched. Set MFA_REQUIRED=true and restart to bring two factor sign in back for everyone, no migration needed.
MFA_REQUIRED=false

# Two factor sign in (when MFA_REQUIRED=true) is required for everyone: Google is only the first step and the authenticator code is always asked.
# This setting cannot be turned off. false is refused at start up. You can leave the line out.
#OIDC_REQUIRE_LOCAL_MFA=true

# ---------------------------------------------------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------------------------------------------------
# The worker runs in its own container, so the API does not run jobs itself.
RUN_WORKER=false
# Audit entries are kept this many months (the nightly job never touches the audit log; "cli audit-trim" is a manual step).
AUDIT_RETENTION_MONTHS=36
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------------------------------
# Never set these in production. The application refuses to start if they are on:
#   DEMO_MODE, PORTAL_FAKE.   ALLOW_NO_SCANNER is only for a short, documented exception.
# ---------------------------------------------------------------------------------------------------------------------
