# /srv/kph/secrets/owner.env  (chmod 600, owner root). Read only by the "migrate" (ops) container, together with app.env.
#
# The database owner login, needed for migrations and for the audit chain check (cli audit-verify, audit-trim).
# The running app and worker never get this file. The password must equal POSTGRES_PASSWORD in db.env.
DATABASE_OWNER_URL=postgres://kph_owner:CHANGE_ME_OWNER_DB_PASSWORD@db:5432/kph
